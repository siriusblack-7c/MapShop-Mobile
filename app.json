{
  "expo": {
    "name": "MapShop",
    "slug": "mapshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mapshop",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.mapshop",
      "config": {
        "googleMapsApiKey": "AIzaSyCVMmbZMaCJDYMNMvKRQAhf-VP5AtVqx6s"
      }
    },
    "android": {
      "package": "com.yourcompany.mapshop",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDVAT8HeahuJB500Cq1AgmeuRQXMCdKSCo"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow MapShop to use your location to show nearby stores.",
          "locationAlwaysPermission": "Allow MapShop to use your location to show nearby stores.",
          "locationWhenInUsePermission": "Allow MapShop to use your location to show nearby stores."
        }
      ]
    ]
  }
}
